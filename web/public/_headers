# Cloudflare Pages response headers for app.zellavoice.com and admin.zellavoice.com (security audit 18 Nov 2026, M14).
# The Content Security Policy is REPORT ONLY for now: browsers log what it would block, nothing is blocked. Switch the
# header name to Content-Security-Policy once a release has run clean (no reports from real pages).
# Sources, from the built app (web/dist): scripts and styles from this site; Google Fonts (index.html); Supabase for the
# API, realtime, edge functions and stored files. Stripe and Vapi are allowed ahead of use (nothing in the app loads
# them today). Inline styles: React sets style attributes, so style-src needs 'unsafe-inline'. No inline scripts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://pffqxlumqhjdbzvvoszm.supabase.co; media-src 'self' blob: https://pffqxlumqhjdbzvvoszm.supabase.co; connect-src 'self' https://pffqxlumqhjdbzvvoszm.supabase.co wss://pffqxlumqhjdbzvvoszm.supabase.co https://api.stripe.com https://api.vapi.ai; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

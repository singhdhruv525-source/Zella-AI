# Cloudflare Pages response headers for app.zellavoice.com and admin.zellavoice.com (security audit 18 Nov 2026, M14).
# The Content Security Policy is REPORT ONLY for now: browsers log what it would block, nothing is blocked. Switch the
# header name to Content-Security-Policy once a release has run clean (no reports from real pages).
# Sources, from the built app (web/dist): scripts and styles from this site; Google Fonts (index.html); Supabase for the
# API, realtime, edge functions and stored files. Vapi is allowed ahead of use. Stripe (owner, 27 Nov 2026): the Pay step
# loads Stripe.js and mounts Stripe's Embedded Checkout form in Stripe's frame, so, as Stripe's integration security
# guide lists for Stripe.js and Checkout: script-src js.stripe.com and *.js.stripe.com; frame-src js.stripe.com,
# *.js.stripe.com, hooks.stripe.com (3D Secure) and checkout.stripe.com; connect-src api.stripe.com and
# checkout.stripe.com. Nothing else of Stripe's is needed by our page (the form's own images and scripts load inside
# Stripe's frame, under Stripe's policy). Inline styles: React sets style attributes, so style-src needs
# 'unsafe-inline'. No inline scripts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://js.stripe.com https://*.js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://pffqxlumqhjdbzvvoszm.supabase.co; media-src 'self' blob: https://pffqxlumqhjdbzvvoszm.supabase.co; connect-src 'self' https://pffqxlumqhjdbzvvoszm.supabase.co wss://pffqxlumqhjdbzvvoszm.supabase.co https://api.stripe.com https://checkout.stripe.com https://api.vapi.ai; frame-src 'self' https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

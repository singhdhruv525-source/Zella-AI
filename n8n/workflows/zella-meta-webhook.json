        "options": {
          "responseCode": 403
        }
      },
      "id": "08b72042-34ee-421d-8ead-7358b6b9f6a8",
      "name": "Refuse check",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        160
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "zella/meta",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "2cc277b8-97b9-41da-862c-d4477b324bf7",
      "name": "Meta events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        400
      ],
      "webhookId": "45067d7b-7597-4df2-89cf-608fd0b9bb8a"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Zella - Meta Webhook: Meta posts events here (leads, messages, comments). The exact bytes it sent are kept, because the\n// signature is made over those bytes. The database checks the signature with the app secret in Vault; this step never sees it.\nconst first = $input.first();\nconst headers = first.json.headers && typeof first.json.headers === 'object' ? first.json.headers : {};\nconst sig = typeof headers['x-hub-signature-256'] === 'string' ? headers['x-hub-signature-256'].slice(0, 100) : '';\nlet raw = '';\ntry {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  raw = buf.toString('utf8');\n} catch (e) { raw = ''; }\nif (raw.length > 500000) raw = '';\nreturn [{ json: { ok: !!raw && !!sig, record: { p_raw: raw, p_signature: sig } } }];\n"
      },
      "id": "2f4240de-4d36-4b52-8ada-e13b4bbc3277",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pffqxlumqhjdbzvvoszm.supabase.co/rest/v1/rpc/zella_meta_receive",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.record) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "37b03cc8-ef98-4009-8191-da40ad5628ce",
      "name": "Save events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        400
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "Zella Supabase service role"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella - Meta Webhook: answer Meta. A wrong signature gets 403; everything else gets 200 so Meta does not keep retrying.\nconst plan = $('Prepare').item.json;\nconst r = $json;\nconst b = r.body && typeof r.body === 'object' ? r.body : {};\nconst bad = !plan.ok || b.result === 'unauthorized';\nreturn { json: { code: bad ? 403 : 200, body: { ok: !bad } } };\n"
      },
      "id": "a16a4eda-7cb2-48e9-8d7e-dd25e809ae9d",
      "name": "Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "responseCode": "={{ $json.code }}"
        }
      },
      "id": "6c2bb735-a46a-4ff3-87fe-2e638d581295",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        400
      ]
    }
  ],

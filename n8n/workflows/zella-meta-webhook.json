        0,
        80
      ],
      "webhookId": "95c4800b-7966-4003-8ffb-f89e5d7fa99f"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella - Meta Webhook (set-up check): when the webhook is first connected, Meta sends a word and a challenge.\n// We hand the word to the database, which compares it with the secret in Vault, and echo the challenge only if it matches.\nconst q = $json.query && typeof $json.query === 'object' ? $json.query : {};\nconst mode = typeof q['hub.mode'] === 'string' ? q['hub.mode'] : '';\nconst token = typeof q['hub.verify_token'] === 'string' ? q['hub.verify_token'].slice(0, 200) : '';\nconst challenge = typeof q['hub.challenge'] === 'string' && /^[A-Za-z0-9_-]{1,100}$/.test(q['hub.challenge']) ? q['hub.challenge'] : '';\nreturn { json: { check: mode === 'subscribe' && !!token && !!challenge, challenge, record: { p_token: token } } };\n"
      },
      "id": "4b5e84be-0e45-41f4-8c38-276a4ec0e7fd",
      "name": "Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pffqxlumqhjdbzvvoszm.supabase.co/rest/v1/rpc/zella_meta_verify_token",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.record) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "8c925420-6d89-4529-89f9-f08639410a2a",
      "name": "Verify word",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        80
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "Zella Supabase service role"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella - Meta Webhook (set-up check): the challenge is echoed only when the database said the word was right.\nconst plan = $('Check').item.json;\nconst r = $json;\nconst ok = plan.check && Number(r.statusCode) >= 200 && Number(r.statusCode) < 300 && r.body === true;\nreturn { json: { ok, challenge: ok ? plan.challenge : '' } };\n"
      },
      "id": "59ad3c89-8ca6-44a6-88af-1cc9b05fb3aa",
      "name": "Answer check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "96848fd5-64a4-497b-8501-8d448cd74f8e",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5de7f824-ac0e-45a8-80dc-885bc61cf666",
      "name": "Word is right",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        80
      ]
    },
    {
      "parameters": {

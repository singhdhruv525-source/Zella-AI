            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "3901f87d-52bc-4f1c-873d-7953d82cff89",
              "leftValue": "={{ !$json.finish }}",
              "rightValue": "",

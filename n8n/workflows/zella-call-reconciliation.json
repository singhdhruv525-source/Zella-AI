    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella - Call Reconciliation: fetch the provider's own record of a call whose end-of-call report never arrived.\n// The database chose the call (zella_calls_to_reconcile); only a well-formed provider call id is ever put in a URL.\nconst id = typeof $json.provider_call_id === 'string' ? $json.provider_call_id : '';\nif (!/^[A-Za-z0-9_-]{6,100}$/.test(id)) return { json: { skip: true, id: null } };\nreturn { json: { skip: false, id, url: 'https://api.vapi.ai/call/' + encodeURIComponent(id) } };\n"
      },
      "id": "ae2f98a0-99fe-4855-8311-26233e9c1364",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "86bd1bc2-f868-4b16-8790-57a7db94f02e",
              "leftValue": "={{ !$json.skip }}",
              "rightValue": "",
              "operator": {

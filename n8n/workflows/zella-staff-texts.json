      },
      "id": "b362e786-2557-4eb6-8f5e-a08d993c65f1",
      "name": "Send via Telnyx",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella - Staff Texts: turn Telnyx's answer into the message update. Only the status and an error code are kept.\nconst plan = $('Plan').item.json;\nconst status = Number($json.statusCode);\nconst b = $json.body && typeof $json.body === 'object' ? $json.body : {};\nconst externalId = b.data && b.data.id ? String(b.data.id) : null;\nconst ok = status >= 200 && status < 300 && !!externalId;\nconst code = Array.isArray(b.errors) && b.errors[0] && b.errors[0].code ? ' (code ' + String(b.errors[0].code).slice(0, 20) + ')' : '';\nreturn { json: { update: { p_id: plan.message_id, p_status: ok ? 'sent' : 'failed', p_external_id: externalId, p_error: ok ? null : 'Telnyx returned ' + status + code + '.' } } };\n"
      },
      "id": "b7016995-6b2a-4faf-8e0b-8124952d1931",
      "name": "After send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella - Staff Texts: one text to a team member, decided by the database (who, what, and the hourly limit).\n// Only a well-formed phone number and a short plain message get through.\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst j = $json || {};\nconst phone = /^\\+[1-9][0-9]{7,14}$/;\nif (typeof j.message_id !== 'string' || !uuid.test(j.message_id) || !phone.test(String(j.to || '')) || !phone.test(String(j.from || ''))) return { json: { skip: true } };\nconst text = String(j.text || '').replace(/[\\u0000-\\u001f\\u007f]/g, ' ').slice(0, 300);\nif (text.length < 5) return { json: { skip: true } };\nreturn { json: { skip: false, message_id: j.message_id, telnyx: { from: j.from, to: j.to, text, type: 'SMS' } } };\n"
      },
      "id": "ae2f98a0-99fe-4855-8311-26233e9c1364",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "9f727a5b-979b-4d20-836d-f88c71842bc4",
              "leftValue": "={{ !$json.skip }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "faedd73d-d2f2-44a3-8403-f8d31e49c5bf",
      "name": "Is a text",

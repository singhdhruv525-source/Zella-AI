      ],
      "webhookId": "f33a7f5b-2e91-44b8-8e57-2a22bc440c5d"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella Voice - Email Events: Resend tells us what happened to an email (delivered, bounced, marked as spam).\n// The secret key in the webhook address and the event are handed to the database, which checks the key.\nconst auth = $('Check Resend auth').item.json;\nif (auth.statusCode !== 200 || auth.body !== 'ok') return { json: { fetch: null, record: null } };\nconst key = typeof ($json.query && $json.query.key) === 'string' ? $json.query.key.slice(0, 200) : '';\nconst h = $json.headers && typeof $json.headers === 'object' ? $json.headers : {};\nconst event = $json.body && typeof $json.body === 'object' && !Array.isArray($json.body) ? $json.body : null;\nconst data = event && event.data && typeof event.data === 'object' ? event.data : {};\nconst eventId = String(h['svix-id'] || (event ? [event.type, data.email_id, event.created_at].filter(Boolean).join(':') : '')).slice(0, 200);\nif (!event || !eventId) return { json: { record: null } };\n// The signature is made over the exact bytes Resend sent, so those are kept. The database checks it against the signing\n// secret in Vault (zella_resend_signing_secret); this step never sees that secret. A missing signing secret is refused by the authentication step.\nlet raw = '';\ntry { raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8'); } catch (e) { raw = ''; }\nif (raw.length > 500000) raw = '';\nconst sig = { id: String(h['svix-id'] || '').slice(0, 200), timestamp: String(h['svix-timestamp'] || '').slice(0, 20), signature: String(h['svix-signature'] || '').slice(0, 500), raw };\nreturn { json: { record: { p_key: key, p_event: event, p_event_id: eventId, p_sig: sig } } };\n"
      },
      "id": "ae2f98a0-99fe-4855-8311-26233e9c1364",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "accd4543-6bcd-4fdb-8f33-0bf3c0930b41",
              "leftValue": "={{ !!$json.record }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",

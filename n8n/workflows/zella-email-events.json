        }
      },
      "id": "5ef0ffaf-bf8b-4a05-879b-b5a3f5ff5b8d",
      "name": "Record event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        100
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "Zella Supabase service role"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella Voice - Email Events: answer Resend. 200 when handled (so it does not resend), 401 for a wrong key,\n// 500 when the database could not be reached (Resend then tries again later). No details are returned.\nconst plan = $('Plan').item.json;\nif (!plan.record) return { json: { status: 400, body: { ok: false } } };\nconst r = $json;\nconst code = Number(r.statusCode);\nconst result = typeof r.body === 'string' ? r.body : '';\nif (code >= 200 && code < 300) {\n  if (result === 'unauthorized') return { json: { status: 401, body: { ok: false } } };\n  if (result === 'not_configured') return { json: { status: 503, body: { ok: false } } };\n  return { json: { status: 200, body: { ok: true } } };\n}\nreturn { json: { status: 500, body: { ok: false } } };\n"
      },
      "id": "bd492bcf-1208-4f71-88a9-a990a5615d47",
      "name": "Build reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "responseCode": "={{ $json.status }}"
        }
      },
      "id": "6c2bb735-a46a-4ff3-87fe-2e638d581295",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Read exact bytes for the mandatory database key and signature check.\nconst j = $json;\nconst h = j.headers || {};\nlet raw = '';\ntry {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  if (buf.length <= 500000) raw = buf.toString('utf8');\n} catch (e) { raw = ''; }\nreturn { json: { record: { p_key: typeof j.query?.key === 'string' ? j.query.key.slice(0, 200) : '', p_endpoint: 'events', p_id: String(h['svix-id'] || '').slice(0, 200), p_timestamp: String(h['svix-timestamp'] || '').slice(0, 20), p_signature: String(h['svix-signature'] || '').slice(0, 500), p_raw: raw || null } } };\n"
      },

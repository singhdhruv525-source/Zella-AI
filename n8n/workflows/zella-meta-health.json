    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella - Meta Health: ask Meta who the token belongs to (a cheap call that fails if the token is dead) and which permissions it has.\nconst plan = $('Plan').item.json;\nconst t = $json.body;\nconst token = typeof t === 'string' && t.length >= 20 && t.length < 1000 ? t : null;\nif (!token) return { json: { ...plan, fail: { p_page_id: plan.page_id, p_ok: false, p_permissions: null, p_auth_failed: true, p_error: 'no_token' } } };\nreturn { json: { ...plan, fail: null, auth: 'Bearer ' + token, url: 'https://graph.facebook.com/v21.0/me?fields=id,name' } };\n"
      },
      "id": "a298f184-f485-4bc7-8f13-b457d0d29f95",

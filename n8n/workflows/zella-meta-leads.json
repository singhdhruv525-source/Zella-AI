        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "7c859611-57fd-4c31-8bf3-a2917153253b",
              "leftValue": "={{ !$json.skip }}",
              "rightValue": "",

    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zella - Meta Leads: one claimed lead event in. Only plain ids are used to build the request.\nconst id = (v, re) => (typeof v === 'string' && re.test(v) ? v : null);\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst eventId = id($json.event_id, uuid);\nconst pageId = id($json.page_id, /^[0-9]{5,30}$/);\nconst leadId = id($json.leadgen_id, /^[0-9]{5,30}$/);\nif (!eventId) return { json: { skip: true } };\nreturn { json: { skip: false, event_id: eventId, page_id: pageId, leadgen_id: leadId, valid: !!(pageId && leadId) } };\n"
      },
      "id": "ae2f98a0-99fe-4855-8311-26233e9c1364",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    },
